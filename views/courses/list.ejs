<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
  <div>
    <p class="eyebrow text-primary mb-1">Teaching workspace</p>
    <h2 class="mb-0">Courses</h2>
  </div>
  <a href="/courses/create" class="btn btn-primary">
    <i class="bi bi-plus"></i> Create Course
  </a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof message !== 'undefined' && message) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row">
  <% if (typeof courses !== 'undefined' && courses.length > 0) { %>
    <% courses.forEach(course => { %>
      <div class="col-md-4 mb-3">
        <div class="card action-card h-100">
          <div class="card-body">
            <div class="feature-icon"><i class="bi bi-journal-text"></i></div>
            <h5 class="card-title"><%= course.code %></h5>
            <p class="card-text"><%= course.name %></p>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <span class="badge bg-light text-dark">Semester <%= course.semester %></span>
              <span class="badge bg-info">Students: <%= course.enrollmentCount || 0 %></span>
            </div>
          </div>
          <div class="card-footer bg-white">
            <div class="d-flex gap-2">
              <a href="/courses/<%= course._id %>" class="btn btn-sm btn-info flex-grow-1">
                <i class="bi bi-eye"></i> View
              </a>
              <button class="btn btn-sm btn-danger" onclick="deleteCourse('<%= course._id %>')">
                <i class="bi bi-trash"></i> Delete
              </button>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12">
      <div class="alert alert-info">No courses found. <a href="/courses/create">Create one now</a></div>
    </div>
  <% } %>
</div>

<script>
function deleteCourse(id) {
  if (confirm('Are you sure? This will delete all enrollments and attendance records.')) {
    fetch(`/courses/${id}`, {
      method: 'DELETE'
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Error: ' + data.error);
      }
    })
    .catch(err => alert('Error: ' + err.message));
  }
}
</script>
