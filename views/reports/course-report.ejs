<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
  <div>
    <p class="eyebrow text-primary mb-1">Course report</p>
    <h2 class="mb-0">Attendance Report</h2>
    <p class="text-muted mb-0">
      <%= typeof report !== 'undefined' && report ? report.course.code + ' - ' + report.course.name : '' %>
    </p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="/reports/course/<%= typeof report !== 'undefined' && report ? report.course._id : '' %>/export-excel" class="btn btn-success">
      <i class="bi bi-file-earmark-excel"></i> Export Excel
    </a>
    <a href="/reports/course/<%= typeof report !== 'undefined' && report ? report.course._id : '' %>/export-csv" class="btn btn-secondary">
      <i class="bi bi-download"></i> Export CSV
    </a>
  </div>
</div>

<div class="row mb-3">
  <div class="col-md-3">
    <div class="card">
      <div class="card-body text-center">
        <span class="metric-label">Total Students</span>
        <h3 class="metric-value mt-2"><%= typeof report !== 'undefined' && report ? report.students : 0 %></h3>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body text-center">
        <span class="metric-label">Sessions</span>
        <h3 class="metric-value mt-2"><%= typeof report !== 'undefined' && report ? report.sessions : 0 %></h3>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table mb-0">
      <thead class="table-light">
        <tr>
          <th>Student ID</th>
          <th>Name</th>
          <th>Email</th>
          <th colspan="<%= typeof report !== 'undefined' && report && report.sessions ? report.sessions : 1 %>">
            Attendance
          </th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof report !== 'undefined' && report && report.data && report.data.length > 0) { %>
          <% report.data.forEach(student => { %>
            <tr>
              <td><strong><%= student.studentId %></strong></td>
              <td><%= student.name %></td>
              <td><%= student.email %></td>
              <% Object.values(student.attendance).forEach(status => { %>
                <td class="text-center">
                  <% if (status === 'P') { %>
                    <span class="badge bg-success">P</span>
                  <% } else if (status === 'A') { %>
                    <span class="badge bg-danger">A</span>
                  <% } %>
                </td>
              <% }); %>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="10" class="text-center py-4 text-muted">No data available</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-3">
  <a href="/courses" class="btn btn-secondary">Back to Courses</a>
</div>
