PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/fingerprint-attendance
SESSION_SECRET=your_super_secret_session_key_change_this_in_production
FINGERPRINT_BRIDGE_API=http://localhost:5000
FINGERPRINT_MOCK_ENABLED=false
FINGERPRINT_CAPTURE_TIMEOUT_MS=30000
FINGERPRINT_CAPTURE_QUALITY=75
FINGERPRINT_MATCH_THRESHOLD=60
MANTRA_BRIDGE_PORT=5000
MANTRA_BRIDGE_PROVIDER=morfin
# For real hardware, run npm run bridge:build, then npm run bridge.
# Override this only if you move the compiled adapter.
# MORFIN_BRIDGE_COMMAND=C:\path\to\MorfinBridgeCli.exe
# Advanced: command mode can point to separate wrappers that print JSON.
# MANTRA_CAPTURE_COMMAND=C:\path\to\mantra-capture.exe
# MANTRA_MATCH_COMMAND=C:\path\to\mantra-match.exe
BCRYPT_ROUNDS=10
