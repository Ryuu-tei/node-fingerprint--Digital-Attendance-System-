<h2 class="mb-4">Course Details</h2>

<div class="row">
  <div class="col-md-8">
    <div class="card mb-3">
      <div class="card-header">
        <h5 class="mb-0"><%= typeof course !== 'undefined' && course ? course.code + ' - ' + course.name : '' %></h5>
      </div>
      <div class="card-body">
        <% if (typeof course !== 'undefined' && course) { %>
          <div class="row mb-3">
            <div class="col-md-6">
              <strong>Code:</strong> <%= course.code %>
            </div>
            <div class="col-md-6">
              <strong>Semester:</strong> <%= course.semester %>
            </div>
          </div>
          <div class="mb-3">
            <strong>Description:</strong>
            <p><%= course.description || 'N/A' %></p>
          </div>
          <div class="row">
            <div class="col-md-6">
              <strong>Max Students:</strong> <%= course.maxStudents %>
            </div>
            <div class="col-md-6">
              <strong>Enrolled:</strong> <%= course.enrollmentCount || 0 %>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Students</h5>
        <a href="/courses/<%= typeof course !== 'undefined' && course ? course._id : '' %>/manage-students" class="btn btn-sm btn-primary">
          Manage
        </a>
      </div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead class="table-light">
            <tr>
              <th>Student ID</th>
              <th>Name</th>
              <th>Email</th>
            </tr>
          </thead>
          <tbody id="courseStudents">
            <tr>
              <td colspan="3" class="text-center py-3 text-muted">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Attendance Sessions</h5>
        <a href="/attendance/course/<%= typeof course !== 'undefined' && course ? course._id : '' %>/create-session" class="btn btn-sm btn-success">
          New Session
        </a>
      </div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead class="table-light">
            <tr>
              <th>Date</th>
              <th>Time</th>
              <th>Marked</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="courseSessions">
            <tr>
              <td colspan="5" class="text-center py-3 text-muted">Loading...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="mt-3">
  <a href="/courses" class="btn btn-secondary">Back to Courses</a>
  <a href="/reports/course/<%= typeof course !== 'undefined' && course ? course._id : '' %>" class="btn btn-outline-primary">Attendance Report</a>
</div>

<script>
const courseId = '<%= typeof course !== 'undefined' && course ? course._id : '' %>';

// Load course students
fetch(`/courses/${courseId}/students`)
  .then(res => res.json())
  .then(data => {
    const tbody = document.getElementById('courseStudents');
    tbody.innerHTML = '';
    if (data.data && data.data.length > 0) {
      data.data.forEach(student => {
        tbody.innerHTML += `
          <tr>
            <td>${student.studentId}</td>
            <td>${student.firstName} ${student.lastName}</td>
            <td>${student.email || '-'}</td>
          </tr>
        `;
      });
    } else {
      tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No students enrolled</td></tr>';
    }
  });

// Load attendance sessions
fetch(`/attendance/course/${courseId}/sessions/api`)
  .then(res => res.json())
  .then(data => {
    const tbody = document.getElementById('courseSessions');
    tbody.innerHTML = '';
    if (data.data && data.data.length > 0) {
      data.data.forEach(session => {
        const statusClass = session.status === 'open' ? 'success' : 'secondary';
        const action = session.status === 'open'
          ? `<a href="/attendance/session/${session._id}/mark" class="btn btn-sm btn-primary">Mark</a>`
          : `<a href="/reports/course/${courseId}" class="btn btn-sm btn-info">Report</a>`;

        tbody.innerHTML += `
          <tr>
            <td>${formatDate(session.sessionDate)}</td>
            <td>${session.startTime} - ${session.endTime}</td>
            <td>${session.markedCount || 0}/${session.totalStudents || 0}</td>
            <td><span class="badge bg-${statusClass}">${session.status}</span></td>
            <td>${action}</td>
          </tr>
        `;
      });
    } else {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No attendance sessions</td></tr>';
    }
  });
</script>
