<h2 class="mb-4">Manage Course Students</h2>

<div class="row">
  <div class="col-md-12">
    <div class="card mb-3">
      <div class="card-header">
        <h5 class="mb-0">
          <%= typeof course !== 'undefined' && course ? course.code + ' - ' + course.name : '' %>
        </h5>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label for="studentSelect" class="form-label">Add Student to Course</label>
          <select id="studentSelect" class="form-control"></select>
        </div>
        <button id="enrollBtn" class="btn btn-primary">Enroll Student</button>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Enrolled Students</h5>
      </div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead class="table-light">
            <tr>
              <th>Student ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Enrollment Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="enrolledStudents">
            <% if (typeof enrollments !== 'undefined' && enrollments.length > 0) { %>
              <% enrollments.forEach(enrollment => { %>
                <tr>
                  <td><%= enrollment.student.studentId %></td>
                  <td><%= enrollment.student.firstName %> <%= enrollment.student.lastName %></td>
                  <td><%= enrollment.student.email || '-' %></td>
                  <td><%= new Date(enrollment.enrollmentDate).toLocaleDateString() %></td>
                  <td>
                    <button class="btn btn-sm btn-danger" onclick="unenrollStudent('<%= enrollment.student._id %>')">
                      Unenroll
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center py-3 text-muted">No students enrolled</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="mt-3">
  <a href="/courses/<%= typeof course !== 'undefined' && course ? course._id : '' %>" class="btn btn-secondary">Back</a>
</div>

<script>
const courseId = '<%= typeof course !== 'undefined' && course ? course._id : '' %>';

// Load available students
fetch('/students/api/search')
  .then(res => res.json())
  .then(data => {
    const select = document.getElementById('studentSelect');
    select.innerHTML = '<option value="">Select a student</option>';
    data.data.forEach(student => {
      select.innerHTML += `<option value="${student._id}">${student.studentId} - ${student.firstName} ${student.lastName}</option>`;
    });
  });

// Enroll student
document.getElementById('enrollBtn').addEventListener('click', function() {
  const studentId = document.getElementById('studentSelect').value;
  if (!studentId) {
    alert('Please select a student');
    return;
  }

  fetch('/enrollments/enroll', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ studentId, courseId })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('Error: ' + data.error);
    }
  })
  .catch(err => alert('Error: ' + err.message));
});

// Unenroll student
function unenrollStudent(studentId) {
  if (confirm('Remove student from course?')) {
    fetch('/enrollments/unenroll', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ studentId, courseId })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Error: ' + data.error);
      }
    })
    .catch(err => alert('Error: ' + err.message));
  }
}
</script>
